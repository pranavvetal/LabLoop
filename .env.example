# ============================================================
# LabLoop Enterprise — Environment Configuration
# ============================================================

# Next.js Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="LabLoop Enterprise"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Optional: Anthropic Claude API for AI Smart Match & Incident Summarizer
# If omitted or unavailable, LabLoop gracefully activates its deterministic offline template fallbacks
# Zero broken flows or runtime exceptions when running without an API key!
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Security & Ledger Configuration
NEXT_PUBLIC_ENABLE_TAMPER_DEMO="true"
NEXT_PUBLIC_ENABLE_STORAGE_SYNC="true"
