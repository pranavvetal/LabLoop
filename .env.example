# Supabase (optional — the app runs fully offline with demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API (optional — AI features gracefully fall back to mock)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (optional — deposits are mocked in demo mode)
STRIPE_SECRET_KEY=sk_test_...

# OCR.space (optional — certificate verification falls back to Tesseract.js)
OCR_SPACE_API_KEY=your-ocr-space-key

# SendGrid (optional — email notifications)
SENDGRID_API_KEY=SG.xxx

# App
NODE_ENV=development
NEXT_PUBLIC_DEMO_MODE=true